# Public canonical URL used in Twilio webhooks and Microsoft OAuth redirects.
APP_BASE_URL=https://your-deployment.example.com

# Optional: bootstrap this account as the owner of the legacy workspace.
APP_OWNER_EMAIL=

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Optional conservative provider allowances. Match values approved in Twilio Console.
TWILIO_CALLS_PER_SECOND=1
TWILIO_MAX_CONCURRENT_CALLS=1

# Optional Telnyx Voice API fallback. Users can also connect Telnyx in-app.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_CALLS_PER_SECOND=1
TELNYX_MAX_CONCURRENT_CALLS=1

# Optional ElevenLabs Agents fallback for Telnyx SIP outbound calls.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_MAX_CONCURRENT_CALLS=1

# Optional Gemini Live fallback for direct Telnyx audio streaming.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
